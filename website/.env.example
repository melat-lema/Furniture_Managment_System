# Copy this file to ".env" and fill in what the client wants to show.
# Anything left empty is simply hidden on the website.

# Leave empty while developing (the website talks to the backend through the /api proxy).
# In production put the backend address, for example https://api.gorgeousfurniture.com/api
VITE_API_URL=

VITE_PHONE=
# WhatsApp number in international format, digits only (for example 251911000000)
VITE_WHATSAPP=
VITE_EMAIL=
VITE_HOURS=
VITE_INSTAGRAM=
VITE_FACEBOOK=
VITE_TELEGRAM=
VITE_TIKTOK=
